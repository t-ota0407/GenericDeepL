<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>assets\icon\GenericDeepL.ico</ApplicationIcon>
    <!-- コード中で使っている `?` 注釈を正規に有効化する（警告 CS8632 の解消）。
         null フロー解析の警告までは有効にしないため既存コードへの影響はない。 -->
    <Nullable>annotations</Nullable>
    <!-- MSI はフレームワーク依存構成で配布しており .NET ランタイムを同梱しない。
         .NET 6 は EOL のため、6.0 が無く 8.0 以降のみの PC でも起動できるようにロールフォワードを許可する。
         （6.0 があればそちらが優先され、無い場合のみ利用可能な最も低い上位メジャーが使われる） -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\icon\GenericDeepL.ico"/>
  </ItemGroup>

  <ItemGroup>
    <None Update="models.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Debugビルド時のみ .env を出力にコピー（存在する場合）。Releaseではコピーしない。 -->
  <ItemGroup Condition="'$(Configuration)'=='Debug'">
    <None Update=".env">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
